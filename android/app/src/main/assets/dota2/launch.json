{
  "schema": 2,
  "gameRoot": "/sdcard/Dota2",
  "exe": "game/bin/win64/dota2.exe",
  "socket": "dota2-input",
  "releaseTag": "mobile",
  "demoOnStart": true,
  "autoLaunch": false,
  "patchSteamApi": true,
  "preset": "requested",
  "_comment": "Phone-first build. DEMO starts right after install and needs no files. Auto-launch is off so the user sees the menu first.",
  "presets": {
    "requested": {
      "args": [
        "-novid",
        "-vulkan",
        "-console",
        "+dota_launch_custom_game"
      ],
      "note": "Exact requested command line. +dota_launch_custom_game requires <addon> <map>; add them here. -vulkan needs DLC AppID 476580 content."
    },
    "bots": {
      "args": [
        "-novid",
        "-vulkan",
        "-console",
        "+map",
        "dota",
        "+dota_bot_populate"
      ],
      "note": "Offline bot match recipe. Needs a working steamclient/GC shim (M6), not just Goldberg."
    },
    "diagnostic": {
      "args": [
        "-novid",
        "-vulkan",
        "-vconsole",
        "-condebug",
        "-windowed",
        "-w",
        "1280",
        "-h",
        "720"
      ],
      "note": "First container boot: maximum logs, low resolution."
    }
  },
  "env": {
    "BOX64_LOG": "0",
    "BOX64_DYNAREC_STRONGMEM": "0",
    "WINEESYNC": "1",
    "WINEDEBUG": "-all",
    "DXVK_HUD": "0",
    "MESA_EXTENSION_MAX_YEAR": "2003"
  },
  "requiredOnDevice": [
    "game/bin/win64/dota2.exe",
    "game/bin/win64/rendersystemvulkan.dll",
    "game/bin/win64/steam_api64.dll",
    "game/dota/bin/win64/client.dll",
    "game/dota/bin/win64/server.dll",
    "game/dota/pak01_dir.vpk",
    "game/dota/pak01_*.vpk",
    "game/core/",
    "DLC AppID 476580 (Dota 2 - Vulkan support) content"
  ]
}
